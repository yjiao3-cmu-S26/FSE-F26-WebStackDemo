# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit a real connection string.

PORT=3000

# Local mongod:
MONGO_URI=mongodb://127.0.0.1:27017/fse_attendance

# Or a shared MongoDB Atlas cluster (works from any machine):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fse_attendance
