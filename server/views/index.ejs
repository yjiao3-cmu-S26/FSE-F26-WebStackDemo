<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Student Profile</title>

  <!--
    TODO 1 — Bootstrap

    Task:
    Add Bootstrap and use Bootstrap classes to style the page.

    Syntax / examples:

    Add Bootstrap CSS:
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    >

    Common Bootstrap classes:
    class="container"
    class="mt-5" margin-top: spacing level 5
    class="mb-4" margin-bottom: spacing level 4
    class="card p-4" padding: spacing level 4
    class="btn btn-primary"
    class="text-center"
    class="text-success"
    class="text-primary"
    class="text-secondary"
    ...
  -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    >

</head>

<body class="container">

  <div class="card">
    <h1 class="card-header">Student Profile</h1>

    <div class="card-body">

      <!--
        TODO 2 — EJS Variables

        Task:
        Replace the hard-coded name and major with
        variables passed from the Express server.

        EJS output syntax:

        &lt;%= variableName %&gt;

        Example:

        &lt;h3&gt;&lt;%= name %&gt;&lt;/h3&gt;
      -->

      <h3 class="card-title"><%= name %></h3>
      <p class="card-text"><%= major %></p>


      <!--
        TODO 3 — EJS Conditional

        Task:
        Show a "TA" badge only when isTA is true.

        EJS JavaScript syntax:

        &lt;% if (condition) { %&gt;

          HTML goes here

        &lt;% } %&gt;

        Example Bootstrap badge:

        <span class="badge text-bg-success">
          TA
        </span>
      -->
      <% if (isTA) { %>
        <span class="badge text-bg-success">
          TA
        </span>
      <% } %>

      <hr>

      <h2 class="text-primary">jQuery Demo</h2>

      <!--
        TODO 4 — jQuery

        Task:
        1. Add the jQuery CDN near the bottom of this file.
        2. Load /app.js after jQuery.
        3. In app.js, handle the button click and update
           the text below.

        jQuery syntax:

        Select:
        $('#element-id')

        Listen for an event:
        $('#element-id').on('click', function () {
          // code
        });

        Change text:
        $('#element-id').text('New text');

        Add these scripts in this order:

        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="/app.js"></script>
      -->

      <button class="btn btn-primary" id="jquery-btn">
        Run jQuery Demo
      </button>

      <p class="text-muted" id="jquery-message">
        Waiting for jQuery...
      </p>

      <hr>

      <h2 class="text-primary">Axios Demo</h2>

      <!--
        TODO 5 — Axios

        Task:
        Click the button to request a message from /api/hello.

        The Axios implementation belongs in client/api.js.

        Add this script to the bottom of the body:
        <script src="https://cdn.jsdelivr.net/npm/axios@1.4.0/dist/axios.min.js"></script>
      -->

      <button class="btn btn-primary" id="api-btn">
        Load Message from API
      </button>

      <p class="text-muted" id="api-message">
        Waiting for API response...
      </p>

    </div>
  </div>


  <!--
    Add the jQuery CDN and /app.js here during TODO 4.
    Add the Axios CDN and /api.js here during TODO 5.

    Keep jQuery before app.js because app.js uses jQuery.
    Keep Axios before api.js because api.js uses axios.
  -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios@1.4.0/dist/axios.min.js"></script>
  <script src="/app.js"></script>
  <script src="/api.js"></script>

</body>
</html>
