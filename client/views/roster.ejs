<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Today's Roster &mdash; Welcome to FSE!</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/fse.css">
</head>
<body class="fse-body">

  <!--
    SERVER-RENDERED, unlike the form page.
    The loop below runs on the SERVER and the browser receives a
    finished table. Compare with attendance.ejs, where the browser
    fetches JSON and builds the DOM itself. Two valid approaches.
  -->

  <main class="container fse-form-wrap">
    <div class="card shadow-sm p-4 p-md-5 mx-auto fse-card fse-card-wide">

      <div class="d-flex justify-content-between align-items-baseline mb-1">
        <h1 class="h3 fw-bold mb-0">Today's roster</h1>
        <span class="badge text-bg-primary fs-6"><%= records.length %> here</span>
      </div>
      <p class="text-secondary mb-4"><%= today %></p>

      <% if (records.length === 0) { %>
        <p class="fst-italic text-secondary mb-0">Nobody has checked in yet today.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th scope="col" class="text-secondary">#</th>
                <th scope="col" class="text-secondary">Name</th>
                <th scope="col" class="text-secondary">Andrew ID</th>
                <th scope="col" class="text-secondary">Checked in</th>
              </tr>
            </thead>
            <tbody>
              <% records.forEach(function (record, index) { %>
                <tr>
                  <td class="text-secondary"><%= index + 1 %></td>
                  <td class="fw-semibold"><%= record.name %></td>
                  <td><code><%= record.andrewId %></code></td>
                  <td class="text-secondary"><%= record.time %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

      <p class="mt-4 mb-0 text-center">
        <a href="/" class="link-secondary small">Back</a>
        <span class="text-secondary small mx-2">&middot;</span>
        <a href="/attendance" class="link-secondary small">Check in</a>
      </p>

    </div>
  </main>

</body>
</html>
