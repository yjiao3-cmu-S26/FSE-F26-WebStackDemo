<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Attendance &mdash; Welcome to FSE!</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/fse.css">
</head>
<body class="fse-body">

  <main class="container fse-form-wrap">
    <div class="card shadow-sm p-4 p-md-5 mx-auto fse-card">

      <h1 class="h3 fw-bold mb-1">Mark your attendance</h1>
      <p class="text-secondary mb-4"><%= today %></p>

      <form id="attendance-form" autocomplete="off" novalidate>

        <!-- FIELD 1 -->
        <div class="mb-3">
          <label for="name" class="form-label fw-semibold">Your name</label>
          <input type="text" class="form-control form-control-lg" id="name"
                 name="name" placeholder="Sophia Chen" maxlength="80" required>
        </div>

        <!-- FIELD 2 -->
        <div class="mb-4">
          <label for="andrewId" class="form-label fw-semibold">Your Andrew ID</label>
          <input type="text" class="form-control form-control-lg" id="andrewId"
                 name="andrewId" placeholder="xc5" maxlength="13" required>
          <div class="form-text">The part of your email before @andrew.cmu.edu</div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100" id="submit-btn">
          Check me in
        </button>
      </form>

      <!-- Filled in by client/scripts/attendance.js after the server answers. -->
      <div id="feedback" class="mt-3" role="status"></div>

      <p class="mt-4 mb-0 text-center">
        <a href="/" class="link-secondary small">Back</a>
        <span class="text-secondary small mx-2">&middot;</span>
        <a href="/roster" class="link-secondary small">Today's roster</a>
      </p>

    </div>
  </main>

  <script src="/scripts/attendance.js"></script>
</body>
</html>
